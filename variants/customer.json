{
  "app-name": "ProTech Support",
  "conn-type": "incoming",
  "disable-ab": "Y",
  "disable-account": "Y",
  "disable-installation": "Y",
  "override-settings": {
    "custom-rendezvous-server": "{{HOST}}",
    "relay-server": "{{RELAY}}",
    "key": "{{KEY}}",
    "register-device": "{{REGISTER}}",
    "api-server": "{{API}}",
    "approve-mode": "click",
    "verification-method": "use-temporary-password",
    "enable-lan-discovery": "N",
    "direct-server": "N",
    "allow-remote-config-modification": "N",
    "allow-auto-update": "N",
    "enable-record-session": "N",
    "enable-camera": "N",
    "enable-terminal": "N",
    "enable-tunnel": "N",
    "enable-remote-printer": "N",
    "enable-remote-restart": "N",
    "enable-block-input": "N",
    "enable-privacy-mode": "N",
    "enable-perm-change-in-accept-window": "Y",
    "hide-server-settings": "Y",
    "hide-proxy-settings": "Y",
    "hide-websocket-settings": "Y",
    "hide-network-settings": "Y",
    "hide-security-settings": "Y",
    "hide-stop-service": "Y",
    "hide-remote-printer-settings": "Y",
    "protech-website-url": "{{SITE}}",
    "protech-source-url": "{{SITE}}/source/"
  }
}
