From a4c6f10c8c86f4ee1411b363935bcd58bf6218cc Mon Sep 17 00:00:00 2001
From: ProTech Build <build@localhost>
Date: Mon, 23 Nov 2026 14:49:47 +1100
Subject: [PATCH 1/2] config: ProTech fail-closed defaults

Default app name, rendezvous server and server public key point at ProTech, so a missing or
invalid custom.txt can never register a customer PC on RustDesk's public server.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/config.rs | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/config.rs b/src/config.rs
index 9ee5cac..7d17290 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -68,7 +68,8 @@ lazy_static::lazy_static! {
     static ref ONLINE: Mutex<HashMap<String, i64>> = Default::default();
     pub static ref PROD_RENDEZVOUS_SERVER: RwLock<String> = RwLock::new("".to_owned());
     pub static ref EXE_RENDEZVOUS_SERVER: RwLock<String> = Default::default();
-    pub static ref APP_NAME: RwLock<String> = RwLock::new("RustDesk".to_owned());
+    // ProTech: branded default so a missing/invalid custom.txt can never fall back to the upstream "RustDesk" identity.
+    pub static ref APP_NAME: RwLock<String> = RwLock::new("ProTech Support".to_owned());
     static ref KEY_PAIR: Mutex<Option<KeyPair>> = Default::default();
     static ref USER_DEFAULT_CONFIG: RwLock<(UserDefaultConfig, Instant)> = RwLock::new((UserDefaultConfig::load(), Instant::now()));
     pub static ref NEW_STORED_PEER_CONFIG: Mutex<HashSet<String>> = Default::default();
@@ -113,8 +114,10 @@ const CHARS: &[char] = &[
     'm', 'n', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z',
 ];
 
-pub const RENDEZVOUS_SERVERS: &[&str] = &["rs-ny.rustdesk.com"];
-pub const RS_PUB_KEY: &str = "OeVuKk5nlHiXp+APNn0Y3pC1Iwpwn44JGqrQCsWqmBw=";
+// ProTech: fail-closed defaults. Without these the client would register on RustDesk's public
+// server (rs-ny.rustdesk.com) whenever custom.txt is missing or fails verification.
+pub const RENDEZVOUS_SERVERS: &[&str] = &["support.prtch.com"];
+pub const RS_PUB_KEY: &str = "qxiKpGCGeDqriWEEGn1lfVaKzZghLjwcoRlA8oZfKjM=";
 
 pub const RENDEZVOUS_PORT: i32 = 21116;
 pub const RELAY_PORT: i32 = 21117;
